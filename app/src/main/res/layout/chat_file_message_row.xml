<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/message"
        android:backgroundTint="#C6E8DF"
        android:padding="8dp"
        android:layout_marginEnd="80dp"
        android:id="@+id/left_chat_layout">

        <ImageButton
            android:id="@+id/left_file_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/file_chat"
            android:background="@android:color/transparent"
            android:contentDescription="Файл"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text=""
                android:textSize="18sp"
                android:id="@+id/left_chat_file" />
            <TextView
                android:id="@+id/left_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15,2 KB"
                android:textColor="#888888"
                android:textSize="18sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/left_details_button"
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="Детали"
            android:src="@drawable/details" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/message"
        android:backgroundTint="#E5E4AA"
        android:layout_alignParentEnd="true"
        android:padding="8dp"
        android:layout_marginStart="80dp"
        android:id="@+id/right_chat_layout">

        <ImageButton
            android:id="@+id/right_file_button"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:src="@drawable/file_chat"
            android:background="@android:color/transparent"
            android:contentDescription="Файл"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:id="@+id/right_chat_file" />
            <TextView
                android:id="@+id/right_file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15,2 KB"
                android:textColor="#888888"
                android:textSize="18sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/right_details_button"
            android:layout_width="48dp"
            android:layout_height="58dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="0dp"
            android:background="@android:color/transparent"
            android:contentDescription="Детали"
            android:src="@drawable/details" />
    </LinearLayout>

</RelativeLayout>